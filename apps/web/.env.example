# Red FaCyT — variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas secretos reales al repositorio.

# URL base de la aplicación (enlaces absolutos y metadatos).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cadena de conexión a PostgreSQL local (fase de backend; aún no requerida).
# Formato en comentario; nunca se versiona una credencial real.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=