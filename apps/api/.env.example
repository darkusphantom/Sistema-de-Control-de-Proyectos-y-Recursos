# Red FaCyT API — variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas secretos reales al repositorio.

# Entorno de ejecución: development | production | test.
NODE_ENV=development

# Puerto HTTP de la API (el web vive en 3000; la API en 3001).
PORT=3001

# Interfaz de escucha del servidor.
HOST=0.0.0.0

# Whitelist estricta de orígenes CORS (CSV), sin reflejo de Origin.
# Requerida en production; no hay defaults silenciosos para ella.
CORS_ORIGINS=http://localhost:3000

# Límite global del cuerpo de petición en bytes (100 KB por defecto).
MAX_BODY_BYTES=102400

# Nivel de log para pino: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=info

# Secreto de firma de sesiones de Better Auth (>= 32 bytes).
# Genera uno con: openssl rand -base64 32
# Requerido en production; fuera de production hay un default de desarrollo
# que el arranque RECHAZA si NODE_ENV=production.
BETTER_AUTH_SECRET=

# URL pública de la API para Better Auth (ej. http://localhost:3001 en dev).
# Requerida en production.
BETTER_AUTH_URL=http://localhost:3001

# Rate limiting de auth (login/register): máximo por ventana y ventana en ms.
# Requeridos en production.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Habilita el documento OpenAPI (/api/v1/openapi.json y /api/v1/docs).
# true | false. Default: false (se expone solo si se pide explícitamente).
OPENAPI_ENABLED=true

# ── Clave futura reservada (llega con PostgreSQL) ────────────────────────────
# Cadena de conexión a PostgreSQL.
# DATABASE_URL=